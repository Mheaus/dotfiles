# Get External IP / local IPs
alias ip="curl ipinfo.io/ip"
alias ips="ifconfig -a | perl -nle'/(\d+\.\d+\.\d+\.\d+)/ && print $1'"
alias speedtest="wget -O /dev/null http://speedtest.wdc01.softlayer.com/downloads/test10.zip"

# Quickly serve the current directory as HTTP

# shell
alias set-title='DISABLE_AUTO_TITLE=true && title'

# docker
alias d="docker"
alias d-c="docker compose"
alias dcup="docker compose up"
alias dcdown="docker compose down"
alias dexec="docker exec"
alias dps="docker ps"
alias dpsa="docker ps -a"
alias dpsf="docker ps -f"
alias dpsft='dps --format "table{{.ID}}\t{{.Names}}\t{{.Status}}"'

# git
alias gclm='git checkout $(git_main_branch) && git pull origin $(git_main_branch)'
alias gsta='git stash'
alias gltag='git fetch && git tag --sort=-version:refname | grep -E "[0-9]+.[0-9]+.[0-9]+" | head -n 1'
alias gt='git tag'
alias gpo='git push origin'
alias gpoc='git push origin $(git_current_branch)'
alias gpocfl='git push origin $(git_current_branch) --force-with-lease'
alias gloc='git pull origin $(git_current_branch)'
alias g-="git switch -"
alias grbmain='git add -A && if [[ -n "$(git status --porcelain)" ]]; then git stash push -m "temporary-stash-for-grbmain"; fi && git switch $(git_main_branch) && git pull origin $(git_main_branch) && git switch - && if git stash list | grep -q "temporary-stash-for-grbmain"; then git stash pop stash@{0}; fi'

# npm
alias npmrmi='rm -rf node_modules package-lock.json && npm i'
alias pnrmi='rm -rf node_modules pnpm-lock.yaml && pnpm i'
alias pn='pnpm'

# bun
alias bi="bun install"
alias bx="bunx"
alias br="bun run"
alias vsc='code .'
alias chrome='open -a "Google Chrome"'

# scripts
alias aisk='pnpm dlx tsx ~/code/mheaus/scripts/aisk.ts'

alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
